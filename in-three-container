#!/usr/bin/env bash
set -euo pipefail

VERSION="0.1.25"
DEFAULT_IMAGE="puc/farcaster-in-three:${VERSION}"
IMAGE="${IN_THREE_IMAGE:-$DEFAULT_IMAGE}"
RELEASE_BASE="${IN_THREE_RELEASE_BASE:-https://github.com/P-U-C/farcaster-in-three/releases/download/v${VERSION}}"

install_docker=false
forward_args=()
for argument in "$@"; do
  if [[ "$argument" == "--install-docker" ]]; then
    install_docker=true
  else
    forward_args+=("$argument")
  fi
done
set -- "${forward_args[@]}"

DOCKER=()

select_docker() {
  command -v docker >/dev/null 2>&1 || return 1

  if docker info >/dev/null 2>&1; then
    DOCKER=(docker)
    return 0
  fi

  if [[ "$(uname -s)" == "Linux" ]] && command -v sudo >/dev/null 2>&1; then
    if sudo -n docker info >/dev/null 2>&1; then
      DOCKER=(sudo -n docker)
      return 0
    fi
    if [[ -t 0 ]] && sudo -v && sudo -n docker info >/dev/null 2>&1; then
      DOCKER=(sudo -n docker)
      return 0
    fi
  fi

  return 1
}

install_ubuntu_docker() {
  if [[ "$(uname -s)" != "Linux" ]] || ! command -v apt-get >/dev/null 2>&1; then
    printf '%s\n' \
      'error: automatic Docker installation supports Ubuntu and Debian only' \
      'Install Docker Desktop or Docker Engine, then rerun this command.' >&2
    exit 1
  fi

  local root=()
  if (( EUID != 0 )); then
    command -v sudo >/dev/null 2>&1 || {
      printf 'error: sudo is required to install Docker on this machine\n' >&2
      exit 1
    }
    if [[ -t 0 ]]; then
      sudo -v
    elif ! sudo -n true >/dev/null 2>&1; then
      printf '%s\n' \
        'error: Docker installation needs sudo approval' \
        'Run this command in a terminal, or install Docker first.' >&2
      exit 1
    fi
    root=(sudo -n)
  fi

  printf 'Installing Docker for the In Three container path (npm is not required)...\n'
  "${root[@]}" apt-get update
  "${root[@]}" env DEBIAN_FRONTEND=noninteractive apt-get install -y docker.io ca-certificates curl gzip
  hash -r

  if command -v systemctl >/dev/null 2>&1; then
    "${root[@]}" systemctl enable --now docker
  elif command -v service >/dev/null 2>&1; then
    "${root[@]}" service docker start
  else
    printf 'error: Docker was installed, but its service could not be started automatically\n' >&2
    exit 1
  fi
}

if ! select_docker; then
  if [[ "$install_docker" == true ]]; then
    if command -v docker >/dev/null 2>&1 && [[ "$(uname -s)" != "Linux" ]]; then
      printf '%s\n' \
        'error: Docker is installed, but its daemon is unavailable' \
        'Start Docker Desktop, then rerun this command.' >&2
      exit 1
    fi
    install_ubuntu_docker
  elif ! command -v docker >/dev/null 2>&1; then
    if [[ -t 0 && -t 1 ]]; then
      printf '%s\n' 'Docker is not installed. npm is not required for this path.'
      printf 'Install Docker now with the Ubuntu/Debian package? [y/N] '
      answer=""
      read -r answer || true
      case "$answer" in
        y|Y|yes|YES|Yes) install_ubuntu_docker ;;
        *)
          printf 'Stopped. Rerun with: ./in-three-container doctor --install-docker\n' >&2
          exit 1
          ;;
      esac
    else
      printf '%s\n' \
        'error: Docker is not installed; npm is not required for this path' \
        'Run: ./in-three-container doctor --install-docker' >&2
      exit 1
    fi
  else
    printf '%s\n' \
      'error: Docker is installed, but the daemon is unavailable or inaccessible' \
      'Start Docker, then rerun this command.' >&2
    exit 1
  fi

  select_docker || {
    printf 'error: Docker was installed, but the daemon is still unavailable\n' >&2
    exit 1
  }
fi

sha256_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
    return
  fi
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
    return
  fi
  printf 'error: sha256sum or shasum is required\n' >&2
  exit 1
}

load_release_image() {
  [[ -z "${IN_THREE_IMAGE:-}" ]] || return 0
  "${DOCKER[@]}" image inspect "$IMAGE" >/dev/null 2>&1 && return 0

  local arch asset cache_dir archive checksum expected actual
  case "$(uname -m)" in
    x86_64|amd64) arch="amd64" ;;
    arm64|aarch64) arch="arm64" ;;
    *)
      printf 'error: unsupported container architecture: %s\n' "$(uname -m)" >&2
      exit 1
      ;;
  esac

  command -v curl >/dev/null 2>&1 || {
    printf 'error: curl is required to fetch the container release\n' >&2
    exit 1
  }
  command -v gzip >/dev/null 2>&1 || {
    printf 'error: gzip is required to load the container release\n' >&2
    exit 1
  }

  cache_dir="$workspace/.state/container-cache"
  umask 077
  mkdir -p "$cache_dir"
  chmod 700 "$workspace/.state" "$cache_dir"
  asset="farcaster-in-three-container-${VERSION}-linux-${arch}.tar.gz"
  archive="$cache_dir/$asset"
  checksum="$cache_dir/${asset}.sha256"

  if [[ ! -f "$archive" || ! -f "$checksum" ]]; then
    local curl_args=(--fail --location --retry 3 --silent --show-error)
    if [[ "$RELEASE_BASE" == https://* ]]; then
      curl_args+=(--proto '=https' --tlsv1.2)
    fi
    printf 'Fetching In Three %s for linux/%s...\n' "$VERSION" "$arch"
    curl "${curl_args[@]}" --output "${checksum}.tmp" "$RELEASE_BASE/${asset}.sha256"
    curl "${curl_args[@]}" --output "${archive}.tmp" "$RELEASE_BASE/$asset"
    mv "${checksum}.tmp" "$checksum"
    mv "${archive}.tmp" "$archive"
  fi

  expected="$(awk 'NR == 1 {print $1}' "$checksum")"
  actual="$(sha256_file "$archive")"
  if [[ ! "$expected" =~ ^[0-9a-f]{64}$ || "$actual" != "$expected" ]]; then
    printf 'error: container archive checksum mismatch; remove %s and retry\n' "$cache_dir" >&2
    exit 1
  fi

  printf 'Loading verified In Three %s container...\n' "$VERSION"
  gzip -dc "$archive" | "${DOCKER[@]}" load >/dev/null
  "${DOCKER[@]}" image inspect "$IMAGE" >/dev/null 2>&1 || {
    printf 'error: release archive did not contain %s\n' "$IMAGE" >&2
    exit 1
  }
}

workspace="$(pwd -P)"
load_release_image

pull_policy="never"
if [[ -n "${IN_THREE_IMAGE:-}" ]]; then
  pull_policy="missing"
fi
args=(
  run
  --rm
  --init
  "--pull=$pull_policy"
  --interactive
  --read-only
  --tmpfs "/tmp:rw,noexec,nosuid,size=64m"
  --cap-drop ALL
  --security-opt no-new-privileges
  --pids-limit 256
  --user "$(id -u):$(id -g)"
  --workdir /work
  --env HOME=/work/.state/container-home
  --env BUY_HOME=/work/.state/buy
  --volume "$workspace:/work"
)

if [[ -t 0 && -t 1 ]]; then
  args+=(--tty)
fi
if [[ -n "${TERM:-}" ]]; then
  args+=(--env TERM)
fi
for name in HCLOUD_TOKEN X402_BASE_PRIVATE_KEY; do
  if [[ -n "${!name:-}" ]]; then
    args+=(--env "$name")
  fi
done

if [[ "${1:-}" == "buy" ]]; then
  shift
  args+=(--entrypoint buy)
fi

exec "${DOCKER[@]}" "${args[@]}" "$IMAGE" "$@"
