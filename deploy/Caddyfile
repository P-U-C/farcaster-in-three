{
  admin off
}

{$CLIENT_DOMAIN} {
  encode zstd gzip
  reverse_proxy client:3333

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
    -Server
  }

  log {
    output stdout
    format json
  }
}
