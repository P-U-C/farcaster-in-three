#!/usr/bin/env bash
set -euo pipefail

IN_THREE_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
IN_THREE_COMMAND="${IN_THREE_COMMAND:-./farcaster}"
export IN_THREE_COMMAND IN_THREE_ROOT

usage() {
  printf 'IN THREE -- a sovereign Farcaster client in three commands\n\n'
  printf 'Usage:\n'
  printf '  %s provision [options]   Provision compute and a 2 TiB data volume\n' "$IN_THREE_COMMAND"
  printf '  %s node up               Install and start a Snapchain read node\n' "$IN_THREE_COMMAND"
  printf '  %s client create         Register an app key and deploy the browser client\n' "$IN_THREE_COMMAND"
  printf '  %s node status           Show sync state and recent logs\n' "$IN_THREE_COMMAND"
  printf '  %s client status         Check the deployed client\n' "$IN_THREE_COMMAND"
  printf '  %s proof                 Write a redacted run receipt\n' "$IN_THREE_COMMAND"
  printf '  %s destroy               Delete provisioned Hetzner resources\n' "$IN_THREE_COMMAND"
  printf '  %s doctor                Check local prerequisites\n\n' "$IN_THREE_COMMAND"
  printf 'Three-command setup:\n'
  printf '  %s provision\n  %s node up\n  %s client create\n\n' \
    "$IN_THREE_COMMAND" "$IN_THREE_COMMAND" "$IN_THREE_COMMAND"
  printf 'Optional agent operation:\n'
  printf '  %s client create --password-file PATH\n' "$IN_THREE_COMMAND"
  printf '  %s client create --with-agent\n' "$IN_THREE_COMMAND"
  printf '  %s deploy --service https://YOUR_BROKER\n' "$IN_THREE_COMMAND"
}

command="${1:-help}"
shift || true

case "$command" in
  deploy)
    exec "$IN_THREE_ROOT/scripts/deploy.sh" "$@"
    ;;
  provision)
    exec "$IN_THREE_ROOT/scripts/provision.sh" "$@"
    ;;
  node)
    subcommand="${1:-status}"
    shift || true
    exec "$IN_THREE_ROOT/scripts/node.sh" "$subcommand" "$@"
    ;;
  client)
    subcommand="${1:-status}"
    shift || true
    exec "$IN_THREE_ROOT/scripts/client.sh" "$subcommand" "$@"
    ;;
  proof)
    exec "$IN_THREE_ROOT/scripts/proof.sh" "$@"
    ;;
  destroy)
    exec "$IN_THREE_ROOT/scripts/destroy.sh" "$@"
    ;;
  doctor)
    exec "$IN_THREE_ROOT/scripts/doctor.sh" "$@"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    usage >&2
    exit 1
    ;;
esac
