{
  "name": "@in-three/client",
  "version": "0.1.19",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && tsup src/server.ts src/setup.ts src/profile.ts src/agent-gateway.ts src/deployment-service.ts --format esm --out-dir dist/server --clean --sourcemap --splitting false",
    "dev": "concurrently -n api,web -c magenta,cyan \"tsx watch src/server.ts\" \"vite\"",
    "start": "node dist/server/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@0xsplits/splits-sdk": "6.7.0",
    "@coinbase/cdp-sdk": "1.59.0",
    "@faker-js/faker": "10.6.0",
    "@farcaster/hub-nodejs": "0.17.0",
    "@fontsource-variable/manrope": "5.2.8",
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@hono/node-server": "1.19.17",
    "@noble/ed25519": "2.3.0",
    "@scure/bip39": "1.6.0",
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "@x402/fetch": "2.28.0",
    "@x402/hono": "2.28.0",
    "hono": "4.13.13",
    "lucide-react": "0.548.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "viem": "2.57.7",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "concurrently": "9.2.5",
    "tsup": "8.5.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
